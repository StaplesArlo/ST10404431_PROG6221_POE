<Window x:Class="Practice_PROG.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz" Height="400" Width="600">
	<Grid Margin="10">
		<TextBlock x:Name="QuestionText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,60"/>
		<StackPanel VerticalAlignment="Bottom">
			<Button Content="A" Click="Answer_Click" Tag="0" Margin="0,5"/>
			<Button Content="B" Click="Answer_Click" Tag="1" Margin="0,5"/>
			<Button Content="C" Click="Answer_Click" Tag="2" Margin="0,5"/>
			<Button Content="D" Click="Answer_Click" Tag="3" Margin="0,5"/>
		</StackPanel>
		<TextBlock x:Name="FeedbackText" FontStyle="Italic" Margin="0,220,0,30" Foreground="DarkGreen"/>
		<TextBlock x:Name="ScoreText" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
	</Grid>
</Window>